# Virtual user auth config
mail_driver = maildir
mail_path = ~/Maildir

passdb vmail_pass {
  driver = passwd-file
  passwd_file_path = /etc/dovecot/passwd
}

userdb vmail_user {
  driver = static
  fields {
    uid=mailuser
    gid=mailuser
    username_format = %{user}
    home=/host/mail/inboxes/%{user | domain}/%{user}
  }
}
